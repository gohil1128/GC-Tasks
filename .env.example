# Postgres. On Vercel, adding a Neon database from the Storage tab sets this for you.
DATABASE_URL="postgresql://gctasks:gctasks@localhost:5432/gctasks?schema=public"
# Any random string of 32+ characters. Signs the session cookie.
AUTH_SECRET="replace-me-with-a-random-string-min-32-chars-long"
AUTH_TRUST_HOST="true"
# Web Push (VAPID). Generate one key pair for this deployment and use the
# same public key in both places: the browser needs it to subscribe, and
# the server needs the pair to sign pushes. The subject is a contact URI.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-base64url-public-key"
VAPID_PRIVATE_KEY="replace-with-base64url-private-key"
VAPID_SUBJECT="mailto:you@example.com"
