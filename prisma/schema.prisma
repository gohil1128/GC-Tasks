// GC Tasks — the God's Chai team board.
//
// Deliberately its own database, separate from God's Chai Operations: this is
// a shared to-do board for the team, not part of the books.
//
// Two kinds of account. Owners can see and change everything and run the
// team. Staff see the whole board but may only work the tasks they are on —
// see src/lib/permissions.ts, which is the one place that line is drawn.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Role {
  OWNER
  STAFF
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  // Defaults to the narrower role: an account only becomes an owner because
  // somebody said so (first-run setup, or an owner promoting it).
  role         Role    @default(STAFF)
  // Set when somebody else chose the password (account created or reset by
  // an owner) and cleared when the person picks their own. Nothing past
  // the change-password screen loads while it is true.
  mustChangePassword Boolean @default(false)
  // Copied into the session cookie at sign-in and compared on every request.
  // Bumped when a password is reset or changed and when an account is
  // deactivated, which signs out every session issued before — a lost phone
  // stays locked out even after its owner picks a new password.
  sessionVersion Int @default(0)
  // Deactivated rather than deleted, so their name stays on the tasks,
  // comments and history they left behind. A deactivated account cannot sign
  // in and is not offered as an assignee.
  active    Boolean  @default(true)
  // Avatar tint, one of the keys in src/lib/colors.ts.
  color     String   @default("rust")
  // The animal they picked from the chai club in src/lib/avatars.ts, or null
  // for "not picked yet" — the avatar then derives one from the account id,
  // so nobody is ever faceless.
  avatar    String?
  // The bell's read watermark: board activity by OTHER people created after
  // this is "unread" for this person. Null = has never opened the bell; the
  // notifications migration stamps existing accounts with its run time, so
  // nobody's whole history lands as unread on day one.
  notificationReadAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTasks Task[]          @relation("TaskCreatedBy")
  updatedTasks Task[]          @relation("TaskUpdatedBy")
  assignments  TaskAssignee[]
  comments     Comment[]
  activity     Activity[]
  pushSubscriptions PushSubscription[]
  ideas        Idea[]
  ideaVotes    IdeaVote[]
  passwordResetCodes PasswordResetCode[]
  teamEvents   TeamEvent[]
}

// One browser/phone that wants board changes pushed to it. A person can
// have several (phone, laptop); a dead endpoint answers 404/410 and the row
// is deleted by the sender. The keys are the subscription's own public
// material — the private half never leaves the device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  status      TaskStatus @default(TODO)
  // Order within the column. A float so a card dropped between two others
  // takes the midpoint and nothing else has to be rewritten; see
  // src/modules/tasks/position.ts for how gaps are kept from running out.
  position    Float
  priority    Priority   @default(MEDIUM)
  // A calendar day, stored as UTC midnight of that day. Never read it in local
  // time — see src/lib/dates.ts.
  dueDate     DateTime?
  // Bumped on every change to what the task SAYS (title, description,
  // priority, due date, people, labels). Moving the card does not bump it, so
  // somebody dragging a card does not invalidate an edit another owner has
  // open — unless the move picks it up for the mover, which adds a person —
  // but two people editing the same task at once do collide, and the second
  // is told rather than silently overwriting the first.
  version     Int        @default(1)
  completedAt DateTime?
  // Archived tasks drop off the board but are kept, with their history.
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User   @relation("TaskUpdatedBy", fields: [updatedById], references: [id])

  assignees TaskAssignee[]
  labels    TaskLabel[]
  checklist ChecklistItem[]
  comments  Comment[]
  activity  Activity[]

  @@index([status, position])
  @@index([archivedAt])
}

model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Label {
  id        String   @id @default(cuid())
  name      String   @unique
  // One of the keys in src/lib/colors.ts.
  color     String
  createdAt DateTime @default(now())

  tasks TaskLabel[]
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  text      String
  done      Boolean  @default(false)
  position  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

// What happened to a task, in words a person can read back. Written in the
// same transaction as the change it describes.
model Activity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  // e.g. "created", "moved", "edited", "assigned", "commented" — see
  // src/modules/tasks/activity.ts for the full list and how each is rendered.
  type      String
  detail    Json     @default("{}")
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
  // The notification bell reads the newest activity across ALL tasks.
  @@index([createdAt])
}

// A single row (id = 1) whose revision goes up by one on every write to the
// board, in the same transaction as the write. Open boards poll it — one
// indexed read — and only fetch the board again when it has moved.
model BoardRevision {
  id        Int      @id @default(1)
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Failed sign-ins, per email and per IP, for the lockout in
// src/modules/auth/rate-limit.ts. Kept in the database rather than in memory
// because serverless instances do not share memory.
model LoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// A "Forgot password?" code emailed to the account; see
// src/modules/auth/password-reset.ts. Only an HMAC of the code is kept. One
// live row per account: asking for a new code deletes the earlier ones.
model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  // Wrong tries against this code; it is dead at five.
  attempts  Int       @default(0)
  // Set when the code is used, so it works once.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A self sign-up waiting for its emailed code; see src/modules/auth/signup.ts.
// Nothing here is an account yet: the User row is made only when the code
// comes back. Holds the password the person chose (bcrypt, as on User) and
// an HMAC of the code. One row per address: asking again replaces it.
model SignupRequest {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  // Wrong tries against this code; it is dead at five.
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
}

// Board-wide switches an owner can flip. A single row (id = 1), like
// BoardRevision; no row reads as every default.
model BoardSetting {
  id          Int      @id @default(1)
  // Whether /signup takes new accounts. On by default — the owners asked
  // for sign-up — and only ever offered while email sending is configured.
  signupsOpen Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// Things that happened to the team rather than to a task, for the owners'
// bell. Activity cannot carry these: its task is required, and the bell's
// feed is built on it. Today the one type is "joined" (somebody signed
// themselves up); see src/modules/notifications/queries.ts.
model TeamEvent {
  id        String   @id @default(cuid())
  type      String
  // Who it is about, shown as the one who did it ("Asha joined the board").
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// The Ideas page: opinions and ideas, threaded like Reddit. Apart from the
// board on purpose — nothing here touches a task, takes the board lock or
// moves the board revision. See src/modules/ideas.
//
// One table for an idea and every reply under it. An idea (top level) has no
// parent and no root, and carries the title. A reply has the post it answers
// as its parent and the idea it belongs to as its root, so a whole thread is
// one indexed read however deep it goes.
model Idea {
  id        String    @id @default(cuid())
  // Null for an idea; the idea or reply this answers, for a reply.
  parentId  String?
  // Null for an idea; the idea a reply sits under.
  rootId    String?
  authorId  String
  // Ideas only; replies leave it null.
  title     String?
  body      String    @default("")
  createdAt DateTime  @default(now())
  // When the author last changed the words. Null = never edited.
  editedAt  DateTime?
  // Set when a post that still has replies is deleted: the body is wiped and
  // it reads "[deleted]", so the replies keep their place. A post with no
  // replies is removed outright instead.
  deletedAt DateTime?

  parent  Idea?      @relation("IdeaReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Idea[]     @relation("IdeaReplies")
  root    Idea?      @relation("IdeaThread", fields: [rootId], references: [id], onDelete: Cascade)
  thread  Idea[]     @relation("IdeaThread")
  author  User       @relation(fields: [authorId], references: [id])
  votes   IdeaVote[]

  @@index([parentId])
  @@index([rootId])
}

// One upvote, by one person, on one idea or reply. The key makes a second
// vote by the same person impossible rather than merely unlikely.
model IdeaVote {
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ideaId, userId])
  @@index([userId])
}
